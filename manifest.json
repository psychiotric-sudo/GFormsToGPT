{
  "manifest_version": 3,
  "name": "GForm to GPT",
  "version": "4.1.5",
  "description": "Scan Google Forms, filter personal questions, and auto-fill with ChatGPT responses",
  "author": "@chqrlzz",
  "web_accessible_resources": [
    {
      "resources": ["welcome.html", "bg.jpg", "welcome.js", "typed.js", "farewell.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "cookies",
    "browsingData",
    "storage",
    "notifications",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://docs.google.com/forms/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.workers.dev/*",
    "https://discord.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/forms/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt_content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["claude_content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini_content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GForm to GPT - Click to clear ChatGPT data",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+M"
      },
      "description": "Toggle the GFormToGPT floating panel"
    }
  }
}
